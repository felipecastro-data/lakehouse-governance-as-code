{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Latest scorecard",
      "queryLines": [
        "WITH latest AS (SELECT * FROM scorecard WHERE run_time = (SELECT max(run_time) FROM scorecard))\n",
        "SELECT\n",
        "  max(CASE WHEN metric = 'pct_owned' THEN value END)      AS pct_owned,\n",
        "  max(CASE WHEN metric = 'pct_classified' THEN value END) AS pct_classified,\n",
        "  max(CASE WHEN metric = 'pct_pii_masked' THEN value END) AS pct_pii_masked,\n",
        "  max(CASE WHEN metric = 'drift_critical' THEN value END) AS drift_critical,\n",
        "  max(CASE WHEN metric = 'drift_warning' THEN value END)  AS drift_warning,\n",
        "  max(CASE WHEN metric = 'untagged_pii' THEN value END)   AS untagged_pii,\n",
        "  max(run_time)                                           AS measured_at\n",
        "FROM latest"
      ]
    },
    {
      "name": "access_kpis",
      "displayName": "Access in the last 30 days",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(*) FROM grant_changes WHERE NOT by_engine AND event_date >= current_date() - INTERVAL 30 DAYS) AS manual_grant_changes,\n",
        "  (SELECT count(*) FROM table_access a JOIN table_inventory i USING (table_full_name)\n",
        "    WHERE i.classification = 'restricted' AND a.access = 'read' AND NOT a.by_pipeline AND a.event_date >= current_date() - INTERVAL 30 DAYS) AS restricted_reads,\n",
        "  (SELECT count(*) FROM access_denied WHERE event_date >= current_date() - INTERVAL 30 DAYS) AS denied_requests"
      ]
    },
    {
      "name": "coverage_trend",
      "displayName": "Coverage trend",
      "queryLines": [
        "SELECT run_time, metric, value FROM scorecard WHERE metric IN ('pct_owned', 'pct_classified', 'pct_pii_masked')"
      ]
    },
    {
      "name": "issue_trend",
      "displayName": "Drift and PII trend",
      "queryLines": [
        "SELECT run_time, metric, value FROM scorecard WHERE metric IN ('drift_critical', 'drift_warning', 'untagged_pii')"
      ]
    },
    {
      "name": "latest_findings",
      "displayName": "Findings in the latest run",
      "queryLines": [
        "SELECT severity, check_name, kind, securable, detail\n",
        "FROM findings\n",
        "WHERE run_id = (SELECT max_by(run_id, run_time) FROM scorecard)\n",
        "ORDER BY severity, check_name, kind, securable"
      ]
    },
    {
      "name": "grant_changes_daily",
      "displayName": "Grant changes per day",
      "queryLines": [
        "SELECT event_date, IF(by_engine, 'gov_engine apply', 'manual') AS source, count(*) AS changes\n",
        "FROM grant_changes\n",
        "WHERE event_date >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "manual_grant_changes",
      "displayName": "Manual grant changes",
      "queryLines": [
        "SELECT event_time, actor, securable_type, securable, principal,\n",
        "       array_join(added, ', ') AS added, array_join(removed, ', ') AS removed, status_code\n",
        "FROM grant_changes\n",
        "WHERE NOT by_engine\n",
        "ORDER BY event_time DESC\n",
        "LIMIT 500"
      ]
    },
    {
      "name": "restricted_access",
      "displayName": "Reads of restricted tables",
      "queryLines": [
        "SELECT a.principal, IF(a.by_pipeline, 'pipeline', 'person') AS principal_type, a.table_full_name,\n",
        "       i.layer, i.classified_by, count(*) AS reads, max(a.event_time) AS last_read\n",
        "FROM table_access a JOIN table_inventory i USING (table_full_name)\n",
        "WHERE i.classification = 'restricted' AND a.access = 'read' AND a.event_date >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY ALL\n",
        "ORDER BY reads DESC"
      ]
    },
    {
      "name": "access_denied",
      "displayName": "Denied requests",
      "queryLines": [
        "SELECT event_time, principal, action_name, securable, status_code, error_message\n",
        "FROM access_denied\n",
        "ORDER BY event_time DESC\n",
        "LIMIT 500"
      ]
    },
    {
      "name": "classification_mix",
      "displayName": "Tables by layer and classification",
      "queryLines": [
        "SELECT layer, coalesce(classification, 'unclassified') AS classification, count(*) AS tables\n",
        "FROM table_inventory\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "pii_by_table",
      "displayName": "PII columns per table",
      "queryLines": [
        "SELECT concat(table_schema, '.', element_at(split(table_full_name, '[.]'), 3)) AS table_name, layer,\n",
        "       pii_columns, columns\n",
        "FROM table_inventory"
      ]
    },
    {
      "name": "policy_changes_daily",
      "displayName": "Policy changes per day",
      "queryLines": [
        "SELECT event_date, IF(by_engine, 'gov_engine apply', 'manual') AS source, count(*) AS changes\n",
        "FROM policy_changes\n",
        "WHERE event_date >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "restricted_by_principal",
      "displayName": "Restricted reads by principal",
      "queryLines": [
        "SELECT IF(a.by_pipeline, 'gov-deployer (pipeline)', a.principal) AS principal, i.layer, count(*) AS reads\n",
        "FROM table_access a JOIN table_inventory i USING (table_full_name)\n",
        "WHERE i.classification = 'restricted' AND a.access = 'read' AND a.event_date >= current_date() - INTERVAL 30 DAYS\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "inventory",
      "displayName": "Table inventory",
      "queryLines": [
        "SELECT table_full_name, layer, owner, classification, classified_by, data_contract,\n",
        "       columns, classified_columns, pii_columns\n",
        "FROM table_inventory\n",
        "ORDER BY layer, table_full_name"
      ]
    }
  ],
